# Supabase Storage (featured images)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL used for auth and links inside emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (reply notification emails). Optional: without the API key, comments
# still work and no notification emails are sent.
RESEND_API_KEY=re_your_api_key
# Must be a verified domain in Resend. The default onboarding@resend.dev sender
# can only deliver to the email address that owns the Resend account.
EMAIL_FROM=The Pigeon Post <notifications@your-domain.com>
